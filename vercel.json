{
  "version": 2,
  "buildCommand": "npm run build:h5",
  "outputDirectory": "dist-h5",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hotel-management-production-wayne.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}